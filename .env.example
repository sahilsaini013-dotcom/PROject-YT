# Training Hub environment variables.
# Copy to apps/web/.env.local for local dev. Never commit real values.

# Supabase project URL. Local stack (`npx supabase start`): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon (publishable) key — safe for the browser; RLS is the guard.
# Local stack prints this after `npx supabase start`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — server-only (backend jobs: notifications, PR detection).
# NEVER exposed to the browser and never used in app request paths.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the app, used in invite emails and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email notifications (captured test transport). Local Mailpit: host 127.0.0.1,
# port 54325 (exposed in supabase/config.toml). In production, real SMTP creds.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Training Hub <no-reply@traininghub.app>
