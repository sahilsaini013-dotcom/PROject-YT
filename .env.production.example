# Production environment for the deployed app (Vercel project settings).
# Copy values from the Supabase dashboard for project `training-hub`
# (ref: buqplfqxyepqtwxmrsui) — never commit real values.

# Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://buqplfqxyepqtwxmrsui.supabase.co

# Publishable (anon) key — safe for the browser; RLS is the guard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The deployed app's own URL (used in invite/notification email links).
NEXT_PUBLIC_SITE_URL=

# Server-only. Not used in app request paths; reserved for backend jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Real SMTP for notification emails (invites, assignments, messages).
# Leave unset to disable email sending (the app degrades gracefully).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Training Hub <no-reply@yourdomain.com>
